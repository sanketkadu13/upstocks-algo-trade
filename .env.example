# Copy to .env and fill in. Never commit the real .env.

BROKER=upstox

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Optional: seeds data/upstox_token.json on first boot only. After that, the
# daily OAuth refresh writes the live token to data/upstox_token.json and this
# value is ignored. Upstox tokens expire ~03:30 IST the next day; re-auth via
# GET /api/auth/login when the dashboard shows "re-authenticate".
UPSTOX_ACCESS_TOKEN=

# --- Automated daily login (optional) ---
# With these set, the app logs itself in whenever the token is missing/expired,
# by driving the real Upstox OAuth page headlessly. Leave blank to disable and
# log in manually via the dashboard banner instead.
# UPSTOX_TOTP_SECRET is the base32 secret shown when you enable 2FA on Upstox
# (not the 6-digit code — the underlying secret behind the QR code).
UPSTOX_MOBILE=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=
AUTO_LOGIN_ENABLED=true

# Server bind
HOST=127.0.0.1
PORT=8000
